# URL do backend LMS (backend_unitec). Sem barra final, sem sufixo /api.
NEXT_PUBLIC_API_URL="http://localhost:5000"

# URL do Auth Service externo (backend_co) — usado apenas no servidor Next.js
# (o plugin de sign-in/sign-up). NÃO prefixar com NEXT_PUBLIC_.
AUTH_SERVICE_URL="http://localhost:4000"

# Segredo que assina/encripta o cookie de sessão do better-auth.
# Gerar com: openssl rand -base64 32
# Alterar este valor invalida todas as sessões activas.
BETTER_AUTH_SECRET=""

# URL pública deste site.
BETTER_AUTH_URL="http://localhost:3000"

# Opcional — só é preciso se o cliente (browser) e a API do better-auth não
# estiverem na mesma origem. Por omissão usa a origem do próprio browser.
# NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Opcional — origens extra autorizadas a invocar as server actions (login,
# registo, checkout), além de BETTER_AUTH_URL e dos localhost de dev.
# Separadas por vírgula, sem protocolo (ex.: "www.unitec.co.mz,unitec.co.mz").
# SERVER_ACTIONS_EXTRA_ORIGINS=""

# Segredo partilhado com o painel admin (admin-unitec, mesma variável) para
# invalidar a cache do catálogo quando um curso é gravado — ver
# app/api/revalidate/route.ts. Sem ele, as alterações aparecem no site ao fim
# de até 60s. Gerar com: openssl rand -base64 32
REVALIDATE_SECRET="5ViVqlzQ8wjRKG2nHm5M3fm6YWY7i5tk4avu1iIVRmV7wDJ9RGUWIcZr"
